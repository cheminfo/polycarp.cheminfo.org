# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Image published by this repository's docker-image workflow.
IMAGE_NAME=ghcr.io/cheminfo/polycarp.cheminfo.org
IMAGE_TAG=latest          # rewritten by the server's deploy script - do not edit by hand

# Prediction backend (Python/FastAPI, built outside this repository).
BACKEND_IMAGE=ghcr.io/lamalab-org/copolymer-reactivity:latest

# Port published on the host (compose.yaml only; the container always serves 80).
# Derived from the first commit date, 2026-04-29: 6+04+29 = 60429, over 60000
# so minus 50000. The Vite dev server runs on PORT + 1.
PORT=10429

# Public hostname (compose.traefik.yaml only).
DOMAIN=polycarp.cheminfo.org

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=

# Audience measurement. The snippet is injected at the end of <head> of the
# served page at container startup, never at build time. Unset means nothing is
# loaded, so a `npm run dev` session tracks nothing. Get this site's
# data-website-id from https://datami.cheminfo.org.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="..."></script>

# API base URL used by the React frontend at build time. In production the
# nginx reverse proxy serves /api/ → backend:8000, so keep the default /api.
# For local testing against the live server:
#   VITE_API_URL=https://polycarp.cheminfo.org/api
VITE_API_URL=/api
